# Immutable image digests are written automatically by deploy/install.sh.
LOTTERY_IMAGE=ghcr.io/coco422/lottery-model-lab:latest

# Bind to loopback by default; put an HTTPS reverse proxy in front for public use.
LOTTERY_BIND_ADDRESS=127.0.0.1
LOTTERY_PORT=8765

# Optional comma-separated browser origins, for example:
# LOTTERY_ALLOWED_ORIGINS=https://lottery.example.com
LOTTERY_ALLOWED_ORIGINS=
LOTTERY_PUBLIC_MAX_FUTURE_DAYS=366

# Conservative defaults for the public prediction-only service.
LOTTERY_MEMORY_LIMIT=1g
LOTTERY_CPU_LIMIT=2.0
